      </visual>
      <visual name="yellow_lane_markings">
        <geometry>
          <mesh>
            <uri>model://xiamen_lane_overlay/meshes/xiamen_lanes_yellow.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.84 0.22 1</ambient>
          <diffuse>0.95 0.84 0.22 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0.45 0.38 0.08 1</emissive>
        </material>
