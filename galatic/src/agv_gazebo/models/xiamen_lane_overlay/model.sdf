<?xml version="1.0"?>
<sdf version="1.9">
  <model name="xiamen_lane_overlay">
    <static>true</static>
    <link name="lane_overlay_link">
      <visual name="white_lane_markings">
        <geometry>
          <mesh>
            <uri>model://xiamen_lane_overlay/meshes/xiamen_lanes_white.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.86 1</ambient>
          <diffuse>0.95 0.95 0.86 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0.45 0.45 0.40 1</emissive>
