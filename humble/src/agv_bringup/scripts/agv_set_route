#!/usr/bin/env python3
import argparse
import math
import sys
import xml.etree.ElementTree as ET

import rclpy
from ament_index_python.packages import get_package_share_directory
from autoware_adapi_v1_msgs.srv import SetRoutePoints
from geometry_msgs.msg import Pose


def tags(element):
    return {tag.get("k"): tag.get("v") for tag in element.findall("tag")}


def distance(a, b):
    return math.hypot(b[0] - a[0], b[1] - a[1])


def point_at_distance(points, target):
    if not points:
        return (0.0, 0.0)
    if target <= 0.0:
        return points[0]

    remaining = target
    for start, end in zip(points, points[1:]):
        segment_length = distance(start, end)
        if segment_length <= 1e-9:
            continue
        if remaining <= segment_length:
            ratio = remaining / segment_length
            return (
                start[0] + (end[0] - start[0]) * ratio,
                start[1] + (end[1] - start[1]) * ratio,
            )
        remaining -= segment_length
    return points[-1]


def polyline_length(points):
    return sum(distance(start, end) for start, end in zip(points, points[1:]))


def resample(points, count):
    if count <= 1:
        return points[:1]
    length = polyline_length(points)
    if length <= 1e-9:
        return [points[0]] * count
    return [point_at_distance(points, length * i / (count - 1)) for i in range(count)]


def align_boundaries(left, right):
    same = distance(left[0], right[0]) + distance(left[-1], right[-1])
    reversed_right = distance(left[0], right[-1]) + distance(left[-1], right[0])
    if reversed_right < same:
        return left, list(reversed(right))
    return left, right


def parse_lanelet_centers(osm_path):
    root = ET.parse(osm_path).getroot()

    nodes = {}
    for node in root.findall("node"):
        node_tags = tags(node)
        if "local_x" not in node_tags or "local_y" not in node_tags:
            continue
        nodes[node.get("id")] = (float(node_tags["local_x"]), float(node_tags["local_y"]))

    ways = {}
    for way in root.findall("way"):
        points = [nodes[nd.get("ref")] for nd in way.findall("nd") if nd.get("ref") in nodes]
        if len(points) >= 2:
            ways[way.get("id")] = points

    centers = []
    for relation in root.findall("relation"):
        relation_tags = tags(relation)
        if relation_tags.get("type") != "lanelet":
            continue
        members = {member.get("role"): member.get("ref") for member in relation.findall("member")}
        left = ways.get(members.get("left"))
        right = ways.get(members.get("right"))
        if not left or not right:
            continue

        left, right = align_boundaries(left, right)
        sample_count = max(len(left), len(right), 2)
        left_samples = resample(left, sample_count)
        right_samples = resample(right, sample_count)
        centerline = [
            ((left_point[0] + right_point[0]) * 0.5, (left_point[1] + right_point[1]) * 0.5)
            for left_point, right_point in zip(left_samples, right_samples)
        ]
        centers.append((int(relation.get("id")), centerline))

    if not nodes:
        raise RuntimeError(f"No local_x/local_y node tags found in {osm_path}")
    if not centers:
        raise RuntimeError(f"No lanelet centerlines found in {osm_path}")
    return centers


def nearest_center_segment(centers, target):
    best = None
    for lanelet_id, centerline in centers:
        for start, end in zip(centerline, centerline[1:]):
            segment_length = distance(start, end)
            if segment_length <= 1e-9:
                continue
            dx = end[0] - start[0]
            dy = end[1] - start[1]
            ratio = ((target[0] - start[0]) * dx + (target[1] - start[1]) * dy) / (
                segment_length * segment_length
            )
            ratio = max(0.0, min(1.0, ratio))
            projected = (start[0] + dx * ratio, start[1] + dy * ratio)
            error = distance(projected, target)
            if best is None or error < best[0]:
                best = (error, lanelet_id, math.atan2(dy, dx))
    if best is None:
        raise RuntimeError("No usable lanelet centerline segments found")
    return best


def yaw_to_pose(x, y, yaw):
    pose = Pose()
    pose.position.x = float(x)
    pose.position.y = float(y)
    pose.position.z = 0.0
    pose.orientation.z = math.sin(yaw * 0.5)
    pose.orientation.w = math.cos(yaw * 0.5)
    return pose


def default_osm_path():
    return get_package_share_directory("agv_maps") + "/map/xiamen-prod.osm"


def main():
    parser = argparse.ArgumentParser(
        description="Set an Autoware route goal using Xiamen OSM local_x/local_y coordinates."
    )
    parser.add_argument("x", type=float, help="Goal x in the map frame")
    parser.add_argument("y", type=float, help="Goal y in the map frame")
    parser.add_argument("--osm", default=default_osm_path(), help="Lanelet2 OSM map path")
    parser.add_argument("--service", default="/api/routing/set_route_points")
    parser.add_argument("--frame-id", default="map")
    parser.add_argument("--allow-goal-modification", action="store_true")
    parser.add_argument("--timeout", type=float, default=10.0)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    error, lanelet_id, yaw = nearest_center_segment(parse_lanelet_centers(args.osm), (args.x, args.y))
    print(
        f"goal=({args.x:.3f}, {args.y:.3f}), yaw={yaw:.6f} rad, "
        f"nearest_lanelet={lanelet_id}, lateral_error={error:.3f} m"
    )
    if args.dry_run:
        return 0

    rclpy.init()
    node = rclpy.create_node("agv_set_route")
    try:
        client = node.create_client(SetRoutePoints, args.service)
        if not client.wait_for_service(timeout_sec=args.timeout):
            print(f"service not available: {args.service}", file=sys.stderr)
            return 1

        request = SetRoutePoints.Request()
        request.header.frame_id = args.frame_id
        request.option.allow_goal_modification = args.allow_goal_modification
        request.goal = yaw_to_pose(args.x, args.y, yaw)

        future = client.call_async(request)
        rclpy.spin_until_future_complete(node, future, timeout_sec=args.timeout)
        if not future.done():
            print(f"service call timed out: {args.service}", file=sys.stderr)
            return 1
        response = future.result()
        if response is None:
            print(f"service call failed: {future.exception()}", file=sys.stderr)
            return 1

        print(
            f"status success={response.status.success} "
            f"code={response.status.code} message={response.status.message!r}"
        )
        return 0 if response.status.success else 1
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    sys.exit(main())
