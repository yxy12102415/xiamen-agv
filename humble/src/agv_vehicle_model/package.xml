<?xml version="1.0"?>
<package format="3">
  <name>agv_vehicle_model</name>
  <version>0.0.1</version>
  <description>Two-axis steering vehicle model sources for Autoware simple_planning_simulator integration.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_simple_planning_simulator</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
