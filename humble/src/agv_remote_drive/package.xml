<?xml version="1.0"?>
<package format="3">
  <name>agv_remote_drive</name>
  <version>0.1.0</version>
  <description>Safe remote-driving command input and AUTO/REMOTE arbitration for the AGV.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>agv_remote_protocol</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
